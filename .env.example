# ─────────────────────────────────────────────────────────────
# Food Rescue Exchange – Backend Environment Variables
# Copy this file to .env for local development.
# Set these as Variables in your Railway service dashboard.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon or any Postgres provider)
# Required for Drizzle ORM migrations
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Node environment
NODE_ENV=production
